#!/bin/sh
#
# Auto-bump the cache-bust ?v= token in index.html so browsers and GitHub Pages
# fetch fresh files instead of serving a stale cached copy.
#
# This file is the TRACKED master copy. .git/hooks/ is not version controlled,
# and an untracked toolchain is exactly how seven scripts went missing here
# before. Install (or reinstall) with:
#
#     cp hooks/pre-commit .git/hooks/pre-commit && chmod +x .git/hooks/pre-commit
#
# Why every token is bumped rather than just the changed file's. The previous
# version rewrote only app.js, data.js and factsheet.js. It happened to catch
# ml_data.js and hq_data.js too, but only because the pattern "data\.js\?v="
# is a substring of "ml_data.js?v=" -- not by intent. holdings.js matched
# nothing, so it was published on 01-10-2026 carrying ?v=1787746192 from weeks
# earlier: the file on disk had October's book in it and returning browsers kept
# serving the cached September one, so the holdings snapshot and the trades view
# came up empty. Bumping all of them costs one extra conditional fetch and
# cannot go stale.

staged=$(git diff --cached --name-only)
case "$staged" in
  *.js) ;;
  *.js*) ;;
  *) exit 0 ;;
esac

VER=$(date +%s)

# Rewrite the ?v= token on every LOCAL script/style the page loads. The pattern
# requires a quote or start-of-attribute before the filename so that, say,
# data.js cannot match inside ml_data.js and bump it twice with a stale value.
sed -i -E "s/([\"/])([A-Za-z0-9_.-]+\.(js|css))\?v=[^\"]+/\1\2?v=${VER}/g" index.html

git add index.html

echo "[pre-commit] cache-bust version bumped to ?v=${VER} (all local js/css)"
exit 0
